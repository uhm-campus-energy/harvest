.venv/

# ignore files generated in/by notebooks
*.csv
*.pdf

.ipynb_checkpoints/
*.pyc

# ignore extra files in notebooks, but keep notebooks and this folder's guide
notebooks/*
!notebooks/*.ipynb
!notebooks/README.md
!notebooks/other/
!notebooks/other/*.ipynb

# dont ignore extracts
!/extracts/
!/extracts/*.csv

# ignore macOS system files
.DS_Store
notebooks/.DS_Store
